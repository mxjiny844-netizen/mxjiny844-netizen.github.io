# ============================================
# EIDEN Partner 환경변수 예시
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.
# 실제 Secret(서비스 키 등)은 절대 소스코드/저장소에 올리지 마세요.
# ============================================

# Supabase 프로젝트 설정 (https://supabase.com → 프로젝트 → Settings → API)
# 이 두 값을 비워두면 앱이 "로컬 데모 모드"로 동작합니다.
# (브라우저 localStorage에 데이터가 저장되어 설치 없이 바로 체험 가능)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 참고: service_role key 같은 비밀 키는 프론트엔드에 절대 넣지 마세요.
# 서버 측 작업이 필요하면 Supabase Edge Function에서만 사용하세요.
